{
  "name": "yoink",
  "version": "1.0.0",
  "description": "yoink! — a first-person 3D multiplayer party game (Three.js + Node.js + Socket.IO)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:static": "node tools/build-static.mjs",
